# Paths for file: URLs are relative to apps/backend.
DATABASE_URL=file:./data/hidrosense.db

# Remote Turso/libSQL: replace DATABASE_URL and fill the token locally.
# DATABASE_URL=libsql://your-database-your-org.turso.io
DATABASE_AUTH_TOKEN=

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Comma-separated exact browser origins; empty disables cross-origin browser access.
CORS_ORIGINS=
# Production TLS proxy IP addresses/CIDRs only; empty trusts no forwarded headers.
TRUSTED_PROXIES=
# Supply BOOTSTRAP_USERNAME, BOOTSTRAP_NAME, BOOTSTRAP_PASSWORD temporarily via
# environment when running npm run auth:bootstrap. Do not commit real passwords.
